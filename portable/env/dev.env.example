# SAP ABAP ADT MCP server 连接配置（On-Premise S/4HANA）
# 用法：复制本文件为 env/<系统名>.env，填入真实值。只支持整行注释，不支持行内注释。

# 系统地址（含协议与 ICM 端口，HTTP 一般 50000，HTTPS 一般 44300）
SAP_URL=https://your-s4-host.company.com:44300
# 集团
SAP_CLIENT=800
# 登录语言
SAP_LANGUAGE=ZH

# 系统类型：onprem（本地 S/4）
SAP_SYSTEM_TYPE=onprem
# 连接方式：http
SAP_CONNECTION_TYPE=http

# 认证方式：basic（用户名 + 密码）
SAP_AUTH_TYPE=basic
# 用户名大小写须与系统 USR02 一致（通常大写），否则创建对象报 PAK049
SAP_USERNAME=YOUR_USER
SAP_PASSWORD=your_password

# 自签名证书场景设为 0（HTTPS 时需要；纯 HTTP 无影响）
TLS_REJECT_UNAUTHORIZED=0
NODE_TLS_REJECT_UNAUTHORIZED=0

# 可选：部分系统在创建/修改对象时需要系统上下文
# SAP_MASTER_SYSTEM=DEV
# SAP_RESPONSIBLE=YOUR_USER
